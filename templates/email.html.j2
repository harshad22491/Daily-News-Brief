<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f1ec;color:#202020;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f3f1ec;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:24px 10px;">
        <table role="presentation" width="620" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:620px;background:#ffffff;border-collapse:collapse;">
          <tr>
            <td style="padding:30px 34px 18px;border-top:5px solid #172b4d;border-bottom:1px solid #d9d5cc;">
              <div style="font-size:12px;line-height:18px;letter-spacing:1.7px;text-transform:uppercase;color:#59636f;">Daily News Briefing</div>
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:36px;font-weight:bold;color:#172b4d;margin-top:5px;">{{ issue_date.strftime('%A, %d %B %Y') }}</div>
              {% if masthead %}<div style="font-size:15px;line-height:23px;color:#4b4b4b;margin-top:10px;">{{ masthead }}</div>{% endif %}
            </td>
          </tr>

          {% if partial_missing %}
          <tr>
            <td style="padding:14px 34px;background:#fff4d6;border-bottom:1px solid #ead7a1;font-size:13px;line-height:19px;color:#6f5411;">
              <strong>Partial edition.</strong> Some inputs were unavailable: {{ partial_missing|join(', ') }}.
            </td>
          </tr>
          {% endif %}

          {% if lead and lead_article %}
          <tr>
            <td style="padding:28px 34px 8px;">
              <div style="font-size:12px;line-height:18px;letter-spacing:1.5px;text-transform:uppercase;color:#8b3a2b;font-weight:bold;">The lead</div>
              <h1 style="font-family:Georgia,'Times New Roman',serif;font-size:28px;line-height:34px;color:#202020;margin:7px 0 12px;">{{ lead_article.title }}</h1>
              <div style="font-size:16px;line-height:25px;color:#2b2b2b;">{{ lead.html|safe }}</div>
              {% if lead_article.cluster_links %}
              <div style="font-size:12px;line-height:18px;color:#777;margin-top:8px;">also:
                {% for link in lead_article.cluster_links %}<a href="{{ link.url }}" style="color:#526b83;">{{ link.source }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </div>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          {% for section in sections %}
          <tr>
            <td style="padding:25px 34px 4px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border-bottom:2px solid #172b4d;">
                <tr>
                  <td style="padding-bottom:7px;font-family:Georgia,'Times New Roman',serif;font-size:23px;line-height:28px;font-weight:bold;color:#172b4d;">{{ section.label }}</td>
                  <td align="right" style="padding-bottom:7px;font-size:11px;line-height:18px;color:#777;white-space:nowrap;">
                    {% if section.rating %}{% for choice in section.rating %}<a href="{{ choice.url }}" style="color:#b47720;text-decoration:none;">{{ choice.score }}★</a>{% if not loop.last %}&nbsp;{% endif %}{% endfor %}{% else %}ratings offline{% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% for brief in section.briefs %}
          <tr>
            <td style="padding:13px 34px 11px;border-bottom:1px solid #ece9e2;">
              <div style="font-size:15px;line-height:23px;color:#2b2b2b;">{{ brief.html|safe }}</div>
              {% if brief.article.cluster_links %}
              <div style="font-size:12px;line-height:18px;color:#777;margin-top:5px;">also:
                {% for link in brief.article.cluster_links %}<a href="{{ link.url }}" style="color:#526b83;">{{ link.source }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </div>
              {% endif %}
              <div style="font-size:11px;line-height:18px;color:#888;margin-top:6px;">
                {% if brief.rating %}{% for choice in brief.rating %}<a href="{{ choice.url }}" style="color:#b47720;text-decoration:none;">{{ choice.score }}★</a>{% if not loop.last %}&nbsp;{% endif %}{% endfor %}{% else %}ratings offline{% endif %}
              </div>
            </td>
          </tr>
          {% endfor %}
          {% if section.noted %}
          <tr>
            <td style="padding:13px 34px 18px;background:#faf9f6;">
              <div style="font-size:12px;line-height:18px;text-transform:uppercase;letter-spacing:1px;color:#666;font-weight:bold;margin-bottom:6px;">Briefly noted</div>
              {% for item in section.noted %}<div style="font-size:13px;line-height:20px;color:#444;margin:3px 0;">• {{ item.line|safe }}</div>{% endfor %}
            </td>
          </tr>
          {% endif %}
          {% endfor %}

          {% if number and number.value %}
          <tr>
            <td style="padding:28px 34px;background:#172b4d;color:#ffffff;">
              <div style="font-size:11px;line-height:17px;text-transform:uppercase;letter-spacing:1.5px;color:#c8d4df;">Number of the Day</div>
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:42px;line-height:48px;font-weight:bold;margin-top:5px;">{{ number.value }}</div>
              <div style="font-size:14px;line-height:21px;font-weight:bold;margin-top:2px;">{{ number.label }}</div>
              <div style="font-size:14px;line-height:22px;color:#e5ebf0;margin-top:7px;">{{ number.gloss }}</div>
              {% if number_article %}<div style="font-size:11px;line-height:17px;margin-top:8px;"><a href="{{ number_article.url }}" style="color:#d9b979;">Source: {{ number_article.source_label }}</a></div>{% endif %}
            </td>
          </tr>
          {% endif %}

          {% if final and final_article %}
          <tr>
            <td style="padding:27px 34px 22px;">
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:27px;font-weight:bold;color:#172b4d;margin-bottom:8px;">And Finally</div>
              <div style="font-size:15px;line-height:23px;color:#333;">{{ final.html|safe }}</div>
            </td>
          </tr>
          {% endif %}

          <tr>
            <td style="padding:22px 34px 30px;background:#eeece7;border-top:1px solid #d9d5cc;font-size:12px;line-height:19px;color:#686868;">
              <div>Keyword changes this week: no editor note supplied.</div>
              <div style="margin-top:5px;">Rate today’s topics above to improve tomorrow’s briefing{% if not ratings_online %} (ratings offline){% endif %}.</div>
              {% if unsubscribe_url %}<div style="margin-top:8px;"><a href="{{ unsubscribe_url }}" style="color:#526b83;">Unsubscribe</a></div>{% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
