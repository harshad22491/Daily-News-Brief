<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#000000;font-family:Georgia,'Times New Roman',serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#ffffff;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:0 10px 30px;">
        <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:640px;border-collapse:collapse;">

          <!-- top bar -->
          <tr>
            <td style="padding:14px 0 12px;border-bottom:1px solid #000000;">
              <span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;letter-spacing:2.5px;text-transform:uppercase;color:#000000;">Daily News Briefing</span>
            </td>
          </tr>

          <!-- masthead -->
          <tr>
            <td style="padding:26px 0 6px;">
              <div style="font-size:40px;line-height:44px;font-weight:bold;color:#000000;">{{ issue_date.strftime('%A') }}</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#6e6e6e;margin-top:6px;">{{ issue_date.strftime('%d %B %Y') }} · Finance / Business / Tech / Politics</div>
              {% if masthead %}<div style="font-size:17px;line-height:26px;color:#000000;margin-top:16px;">{{ masthead }}</div>{% endif %}
            </td>
          </tr>

          {% if partial_missing %}
          <tr>
            <td style="padding:12px 14px;margin:0;background:#fff8e1;border:1px solid #e6d089;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#6f5411;">
              <strong>Partial edition.</strong> Some inputs were unavailable: {{ partial_missing|join(', ') }}.
            </td>
          </tr>
          {% endif %}

          <!-- lead essay -->
          {% if lead and lead_article %}
          <tr>
            <td style="padding:22px 0 10px;">
              <h1 style="font-size:30px;line-height:37px;font-weight:bold;color:#000000;margin:0 0 16px;"><a href="{{ lead_article.url }}" style="color:#000000;text-decoration:none;">{{ lead_article.title }}</a></h1>
              <div style="font-size:18px;line-height:29px;color:#000000;">{{ lead.html|safe }}</div>
              {% if lead_article.cluster_links %}
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6e6e6e;margin-top:10px;">Also covered by
                {% for link in lead_article.cluster_links %}<a href="{{ link.url }}" style="color:#0068ff;">{{ link.source }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </div>
              {% endif %}
            </td>
          </tr>
          {% endif %}

          <!-- topic sections -->
          {% for section in sections %}
          <tr>
            <td style="padding:34px 0 0;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                <tr><td colspan="2" style="border-top:4px solid #000000;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr>
                  <td style="padding-top:2px;font-size:26px;line-height:32px;font-weight:bold;color:#000000;">{{ section.label }}</td>
                  <td align="right" style="padding-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6e6e6e;white-space:nowrap;vertical-align:top;">
                    {% if section.rating %}Rate this section&nbsp; {% for choice in section.rating %}<a href="{{ choice.url }}" style="color:#0068ff;text-decoration:none;">{{ choice.score }}★</a>{% if not loop.last %}&nbsp;&nbsp;{% endif %}{% endfor %}{% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% for brief in section.briefs %}
          <tr>
            <td style="padding:16px 0 14px;{% if not loop.last %}border-bottom:1px solid #e6e6e6;{% endif %}">
              <div style="font-size:16px;line-height:26px;color:#000000;">{{ brief.html|safe }}</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6e6e6e;margin-top:7px;">
                {% if brief.article.cluster_links %}Also: {% for link in brief.article.cluster_links %}<a href="{{ link.url }}" style="color:#0068ff;">{{ link.source }}</a>{% if not loop.last %}, {% endif %}{% endfor %} &nbsp;·&nbsp; {% endif %}
                {% if brief.rating %}Rate&nbsp; {% for choice in brief.rating %}<a href="{{ choice.url }}" style="color:#0068ff;text-decoration:none;">{{ choice.score }}★</a>{% if not loop.last %}&nbsp;{% endif %}{% endfor %}{% endif %}
              </div>
            </td>
          </tr>
          {% endfor %}
          {% if section.noted %}
          <tr>
            <td style="padding:14px 0 6px;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;text-transform:uppercase;letter-spacing:1.5px;color:#000000;font-weight:bold;margin-bottom:8px;">Briefly noted</div>
              {% for item in section.noted %}<div style="font-size:14px;line-height:23px;color:#000000;margin:4px 0;">{{ item.line|safe }}</div>{% endfor %}
            </td>
          </tr>
          {% endif %}
          {% endfor %}

          <!-- number of the day -->
          {% if number and number.value %}
          <tr>
            <td style="padding:36px 0 0;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                <tr><td style="border-top:4px solid #000000;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr><td style="padding-top:2px;font-size:26px;line-height:32px;font-weight:bold;color:#000000;">Number of the Day</td></tr>
                <tr><td style="padding-top:14px;font-size:64px;line-height:66px;font-weight:bold;color:#0068ff;">{{ number.value }}</td></tr>
                <tr><td style="padding-top:6px;font-size:16px;line-height:24px;font-weight:bold;color:#000000;">{{ number.label }}</td></tr>
                <tr><td style="padding-top:6px;font-size:16px;line-height:26px;color:#000000;">{{ number.gloss }}</td></tr>
                {% if number_article %}<tr><td style="padding-top:8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;"><a href="{{ number_article.url }}" style="color:#0068ff;">Source: {{ number_article.source_label }}</a></td></tr>{% endif %}
              </table>
            </td>
          </tr>
          {% endif %}

          <!-- and finally -->
          {% if final and final_article %}
          <tr>
            <td style="padding:36px 0 8px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                <tr><td style="border-top:4px solid #000000;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr><td style="padding-top:2px;font-size:26px;line-height:32px;font-weight:bold;color:#000000;">And Finally</td></tr>
                <tr><td style="padding-top:12px;font-size:16px;line-height:26px;color:#000000;">{{ final.html|safe }}</td></tr>
              </table>
            </td>
          </tr>
          {% endif %}

          <!-- footer -->
          <tr>
            <td style="padding:30px 0 10px;border-top:1px solid #000000;margin-top:26px;">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6e6e6e;">
                Your star ratings shape tomorrow's edition — selection weights update daily and a critique pass runs every Sunday{% if not ratings_online %} (ratings are offline in this preview){% endif %}.
              </div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6e6e6e;margin-top:6px;">Keyword changes this week: no editor note supplied.</div>
              {% if unsubscribe_url %}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;margin-top:10px;"><a href="{{ unsubscribe_url }}" style="color:#0068ff;">Unsubscribe</a></div>{% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
